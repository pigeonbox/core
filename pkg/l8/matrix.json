      "app/share/reldir_test.go",
      "storage/opendal/resolve_path_guard_test.go",
      "pkg/utils/security_test.go"
    ]
  },
  "cases": [
    {
      "id": "AB-01",
      "class": "auth_bypass",
      "title": "JWT 签名算法白名单：alg=none 与非 HS256 一律拒绝",
      "verdict": "只有 HS256 签名的令牌可被解析成身份；alg=none/HS384/HS512（含同一密钥签出的）一律判无效",
      "tests": [
        "pkg/auth/l8_jwt_algorithm_test.go::TestL8_JWTRejectsForeignSecret",
        "pkg/auth/l8_jwt_algorithm_test.go::TestL8_JWTRejectsNonHS256Algorithm",
        "pkg/auth/l8_jwt_algorithm_test.go::TestL8_JWTRejectsNoneAlgorithm",
        "pkg/auth/l8_jwt_algorithm_test.go::TestL8_JWTValidHS256StillAccepted"
      ]
    },
    {
      "id": "AB-02",
      "class": "auth_bypass",
      "title": "二验半会话（pending-2FA）不得续签，且在一切认证面被拒",
      "verdict": "半会话带 MFAPending 标记，RefreshToken 拒绝续签（ErrMFAPending），认证中间件一律 401",
      "tests": [
        "pkg/auth/l8_mfa_pending_test.go::TestL8_PendingMFATokenCannotBeRefreshed",
        "pkg/auth/l8_mfa_pending_test.go::TestL8_PendingMFATokenIsMarked",
        "pkg/middleware/auth_test.go::TestMFAPendingTokenRejectedByAuthMiddlewares"
      ]
    },
    {
      "id": "AB-03",
